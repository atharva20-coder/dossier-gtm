# ---------------------------------------------------------------- API keys ---
# Required. A run cannot proceed without both.
TAVILY_API_KEY=tvly-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional person-level signal provider (Super Carl). Without it the app falls
# back to web search alone, which still works — this is an enhancement, never a
# dependency. It is what reaches a prospect's own profile and posts.
SUPERCARL_API_KEY=
# Per REQUEST, and a lookup makes two (resolve, then profile text with posts).
# 15 was too tight: the text call timed out on profiles that had just resolved,
# which spends the resolve call and returns nothing.
SUPERCARL_TIMEOUT_S=38
SUPERCARL_POSTS_LIMIT=15
# Resolved profiles are cached this long. The provider allowance is small.
SUPERCARL_CACHE_DAYS=30

# === OUTBOUND PIPELINE =====================================================
# Optional. Used for competitor discovery and waterfall email enrichment.
HUNTER_API_KEY=
QEV_API_KEY=

# ---------------------------------------------------------------- database ---
# Supabase. Use the TRANSACTION pooler string (port 6543) from
# Dashboard -> Project Settings -> Database -> Connection string -> Transaction
# pooler. Not the direct connection on 5432 — see backend/db.py for why.
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Per-process pool ceiling. (this value) x (concurrent instances) must fit
# inside the pooler's client budget. Raising it is how you cause an outage.
DB_POOL_MAX=4
# Idle connections kept open. 0 for serverless; 1 on a long-lived host.
DB_POOL_MIN=0
DB_COMMAND_TIMEOUT_S=15
# A run that has not written a stage in this long is dead, not slow.
RUN_STALE_AFTER_S=600

# ------------------------------------------------------------------ models ---
MODEL_FAST=gemini-2.5-flash
MODEL_SMART=gemini-3.8-flash
# Reasoning-token cap on the mechanical model. 512 = same facts, 2.6x faster.
FAST_THINKING_BUDGET=512

# ------------------------------------------------------------ tuning knobs ---
SEARCH_TIMEOUT_S=8
# Extraction is the long pole: ~35k characters in, structured facts out.
LLM_TIMEOUT_S=90
MAX_CONCURRENT_SEARCHES=6
MAX_RESULTS_PER_QUERY=5
# Research traversal: how far the system walks outward from the prospect,
# following what each wave of results turns up. Every node explored is a search
# credit, so these are cost limits first and quality knobs second.
GRAPH_MAX_DEPTH=2
GRAPH_MAX_NODES=12
GRAPH_QUERY_BUDGET=8
# Extraction reads sources in concurrent batches of this size, up to this total.
EXTRACT_SOURCES_PER_CALL=5
EXTRACT_MAX_SOURCES=20

# A fact older than this can never become the hook.
FACT_RECENCY_MAX_DAYS=180
# Outreach value peaks inside this window and decays after.
OUTREACH_PEAK_DAYS=21
OUTREACH_DECAY_DAYS=60

# Identity resolution thresholds (see DECISION_LOGIC.md, Decision Point 1).
IDENTITY_AUTO_PROCEED_SCORE=60
IDENTITY_AMBIGUITY_MARGIN=20

# Batch safety: bulk upload changed the cost model, so it needs a ceiling.
MAX_ROWS_PER_UPLOAD=200

# Accepted edits a persona gathers before rewriting its own instructions.
PERSONA_LEARN_AFTER=3
# Ceiling on learned rules; past it the persona corrects instead of adding.
PERSONA_MEMORY_CAP=10

# === ACCESS CONTROL ========================================================
#
# One shared key gates the whole API. LEAVE IT UNSET LOCALLY; SET IT IN
# PRODUCTION. Every endpoint either spends search/model credits or returns
# prospect data, so an open URL is someone else's quota and your prospect list.
# Startup logs a warning whenever this is unset.
APP_ACCESS_KEY=

# Signs the session cookie. Unset means a random value per process, so everyone
# is logged out on every restart and sessions do not work across instances.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# How long a session lasts, in seconds. Default 12 hours.
SESSION_TTL_S=43200

# Upload size ceiling, checked before the file is parsed into memory.
MAX_UPLOAD_BYTES=8388608

# /api/health makes real API calls; cache it so page loads do not spend credits.
HEALTH_CACHE_S=300

# === SENDING (Gmail) =======================================================
#
# Leave blank and the Send button stays disabled — everything else still works.
#
# Gmail needs an APP PASSWORD, not your account password:
#   1. Turn on 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords  ->  create one for "Mail"
#   3. Paste the 16 characters below (spaces are ignored)
#
# This credential can send mail as you. Never commit it.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional display name on the From header.
GMAIL_SENDER_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT_S=20
